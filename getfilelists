#!/bin/sh -ex
# SPDX-License-Identifier: GPL-2.0-only
# usage: getfilelists <repo-base-url>

url=$1
[ -n "$url" ] || { echo "usage: $0 <repo-base-url>" >&2; exit 1; }

wget -N "$url/repodata/repomd.xml"
p=$(grep -o '[^"]*-filelists\.xml\.[a-z]*' repomd.xml | head -n1)
# repomd.xml is mirror-controlled, so accept only a plain relative path
case "$p" in
	""|/*|*..*) echo "unexpected filelists path: $p" >&2; exit 1 ;;
esac
n=$(basename "$p")
# the name is content-addressed, so an existing file needs no refetch - but
# fetch via .part so an interrupted transfer never looks like a complete one
if [ ! -e "$n" ]; then
	wget --progress=dot:mega -O "$n.part" "$url/$p"
	mv "$n.part" "$n"
fi
ln -f "$n" "filelists.xml.${n##*.}"
